model RegisteredCrop {
  id                    String              @id @default(cuid())
  userId                String
  guidelineId           String              // REQUIRED: Reference to CropGuideline
  cropType              String
  variety               String
  plantingDate          DateTime            // When the crop was planted - duration tracking starts here
  expectedHarvest       DateTime?
  area                  Float?
  status                CropStatus          @default(Active)
  currentStageIndex     Int                 @default(0) // Track which guideline stage (0-based index)
  currentStageName      String?             // Name of current stage from guideline
  currentStageStartDate DateTime?           // When current stage started
  currentStageEndDate   DateTime?           // When current stage should end (based on duration)
  totalStages           Int?                // Total number of stages from guideline
  notes                 String?
  archiveReason         String?             // Reason for archiving
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  reports               StageReport[]       // One report per stage
  messages              CropStageMessage[]  // Messages about this crop
  user                  Account             @relation(fields: [userId], references: [id], onDelete: Cascade)
  guideline             CropGuideline       @relation(fields: [guidelineId], references: [id], onDelete: Restrict)

  @@index([userId, cropType, status])
  @@index([guidelineId])
  @@index([currentStageIndex])
  @@index([plantingDate])
  @@map("registered_crops")
}

// One report per stage - required for each stage
model StageReport {
  id                    String              @id @default(cuid())
  cropId                String
  stageIndex            Int                 // Which stage this report is for (0-based)
  stageName             String              // Name of the stage being reported
  status                ReportStatus        @default(Pending) // Pending, Submitted, Late
  reportDueDate         DateTime?           // When report must be submitted (stage end + grace period)
  submittedAt           DateTime?           // When farmer actually submitted
  
  // Report content fields
  plantHeight           Float?
  healthStatus          String?
  weatherImpact         String?
  notes                 String?             @db.Text
  pestsObserved         String?
  diseasesObserved      String?
  fertilizersApplied    String?
  pesticideApplications String?
  irrigationFrequency   String?
  soilCondition         String?
  plannedActions        String?
  actualYield           Float?
  costs                 String?             @db.LongText // JSON
  weatherSnapshot       String?             @db.LongText // JSON
  
  createdAt             DateTime            @default(now()) // When report entry was created
  updatedAt             DateTime            @updatedAt
  crop                  RegisteredCrop      @relation(fields: [cropId], references: [id], onDelete: Cascade)
  feedback              ReportFeedback[]

  @@unique([cropId, stageIndex]) // One report per stage per crop
  @@index([cropId, stageIndex])
  @@index([status, reportDueDate])
  @@map("stage_reports")
}

model ReportFeedback {
  id        String         @id @default(cuid())
  reportId  String
  authorId  String
  message   String         @db.Text
  parentId  String?        // For threaded replies
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  report    StageReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author    Account        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    ReportFeedback? @relation("FeedbackReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ReportFeedback[] @relation("FeedbackReplies")

  @@index([reportId, createdAt])
  @@index([parentId])
  @@map("report_feedback")
}

model CropStageMessage {
  id                String           @id @default(cuid())
  cropId            String
  userId            String           // Who sent the message
  stageIndex        Int              // Which stage this message is about
  stageName         String           // Name of the stage
  message           String           @db.Text
  isAdminReply      Boolean          @default(false) // True if admin is replying
  parentId          String?          // For threaded replies
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  crop              RegisteredCrop   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  user              Account          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent            CropStageMessage? @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           CropStageMessage[] @relation("MessageReplies")

  @@index([cropId, createdAt])
  @@index([cropId, stageIndex])
  @@index([parentId])
  @@map("crop_stage_messages")
}

enum CropStatus {
  Active
  Inactive
  Completed
  Archived
}

enum ReportStatus {
  Pending    // Report not yet submitted, within deadline
  Submitted  // Report submitted on time
  Late       // Report submitted after deadline OR not submitted and past deadline
}

enum GrowthStage {
  Seedling
  Vegetative
  Flowering
  Fruiting
  Maturity
  Harvested
}
