model Notification {
  id          String            @id @default(cuid())
  accountId   String
  type        notification_type
  title       String
  message     String            @db.Text
  relatedId   String?           // Related transaction/item/seminar ID
  read        Boolean           @default(false)
  createdAt   DateTime          @default(now())
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "notifications_accountId_idx")
  @@index([accountId, read], map: "notifications_accountId_read_idx")
  @@index([createdAt], map: "notifications_createdAt_idx")
  @@map("notifications")
}

model NotificationSettings {
  id                    String  @id @default(cuid())
  accountId             String  @unique
  emailEnabled          Boolean @default(true)
  requestApproved       Boolean @default(true)
  requestRejected       Boolean @default(true)
  itemDueSoon           Boolean @default(true)
  itemOverdue           Boolean @default(true)
  seminarReminder       Boolean @default(true)
  account               Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

enum notification_type {
  REQUEST_APPROVED
  REQUEST_REJECTED
  ITEM_DUE_SOON
  ITEM_OVERDUE
  SEMINAR_REMINDER
  SYSTEM_ALERT
}
