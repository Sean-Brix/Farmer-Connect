model Inquiry {
  id           String              @id @default(cuid())
  subject      String
  message      String              @db.LongText
  status       InquiryStatus       @default(PENDING)
  userId       String
  guestName    String?
  guestEmail   String?
  assignedToId String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  assignedTo   Account?            @relation("AssignedInquiries", fields: [assignedToId], references: [id])
  resolvedBy   Account?            @relation("ResolvedInquiries", fields: [resolvedById], references: [id])
  user         Account             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments  InquiryAttachment[]
  replies      InquiryReply[]

  @@index([status])
  @@index([userId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, updatedAt]) // Composite index for sorted active queries
  @@index([resolvedById], map: "inquiries_resolvedById_fkey")
  @@map("inquiries")
}

model InquiryReply {
  id            String         @id @default(cuid())
  message       String         @db.LongText
  senderId      String?
  senderType    SenderType
  senderName    String?
  inquiryId     String
  parentReplyId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  readByUser    Boolean        @default(false)
  readByAdmin   Boolean        @default(false)
  readAt        DateTime?
  inquiry       Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  parentReply   InquiryReply?  @relation("ReplyThread", fields: [parentReplyId], references: [id])
  childReplies  InquiryReply[] @relation("ReplyThread")
  sender        Account?       @relation(fields: [senderId], references: [id])

  @@index([inquiryId])
  @@index([senderId])
  @@index([createdAt])
  @@index([senderType])
  @@index([readByAdmin, senderType]) // Composite index for unread admin messages
  @@index([readByUser, senderType]) // Composite index for unread user messages
  @@index([parentReplyId], map: "inquiry_replies_parentReplyId_fkey")
  @@map("inquiry_replies")
}

model InquiryAttachment {
  id           String   @id @default(cuid())
  filename     String
  filepath     String?
  filesize     Int
  mimetype     String
  fileData     Bytes?
  inquiryId    String
  uploadedById String?
  createdAt    DateTime @default(now())
  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  uploadedBy   Account? @relation(fields: [uploadedById], references: [id])

  @@index([inquiryId])
  @@index([uploadedById], map: "inquiry_attachments_uploadedById_fkey")
  @@map("inquiry_attachments")
}

model FAQCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Account? @relation(fields: [createdById], references: [id])
  faqs        FAQ[]

  @@index([isActive])
  @@index([orderIndex])
  @@index([createdById], map: "faq_categories_createdById_fkey")
  @@map("faq_categories")
}

model FAQ {
  id           String       @id @default(cuid())
  question     String
  answer       String       @db.LongText
  isActive     Boolean      @default(true)
  orderIndex   Int          @default(0)
  createdById  String?
  viewCount    Int          @default(0)
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  categoryId   String?
  category     FAQCategory? @relation(fields: [categoryId], references: [id])
  createdBy    Account?     @relation(fields: [createdById], references: [id])

  @@index([isActive])
  @@index([orderIndex])
  @@index([categoryId])
  @@index([createdById], map: "faqs_createdById_fkey")
  @@map("faqs")
}

enum InquiryStatus {
  PENDING
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CANCELLED

  @@map("inquiry_status")
}

enum SenderType {
  USER
  ADMIN
  BOT

  @@map("sender_type")
}
