model InventoryItem {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  picture       Bytes?
  category      item_category  @default(Other)
  seedVarietyId String? // For Seeds category - links to seed variety
  unit          String? // "bags", "kilograms", "packets"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  item_stacks   ItemStack[]
  seedVariety   SeedVariety?   @relation(fields: [seedVarietyId], references: [id])

  @@map("inventory_items")
}

model ItemStack {
  id                       String                 @id @default(cuid())
  itemId                   String
  quantity                 Int                    @default(1)
  reservedQuantity         Int                    @default(0)
  status                   item_status            @default(Available)
  date_limit               Int?
  max_quantity_per_request Int?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  item                     InventoryItem          @relation(fields: [itemId], references: [id])
  itemTransactions         ItemTransaction[]
  distributionQuota        DistributionQuota?
  distributionHistory      DistributionHistory[]
  distributionWaitlist     DistributionWaitlist[]

  @@index([itemId], map: "item_stacks_itemId_fkey")
  @@map("item_stacks")
}

model ItemTransaction {
  id                 String             @id @default(cuid())
  itemStackId        String
  accountId          String
  adminId            String?
  quantity           Int                @default(1)
  status             transaction_status @default(Pending)
  pickupDate         DateTime
  returnDate         DateTime?
  requestNote        String?
  autoStatusChanged  Boolean            @default(false)
  statusChangedAt    DateTime?
  statusChangeReason String?
  previousStatus     String?
  actual_pickup              DateTime?
  actual_return              DateTime?
  adjustedReturnDate         DateTime?
  plantingReportRequired     Boolean          @default(false)
  plantingReportId           String? // String to match PlantingReport.id (cuid)
  plantingReportDeadline     DateTime?
  plantingReportSubmittedAt  DateTime?
  plantingReportArchivedAt   DateTime?
  // Farmer-provided distribution details (required on request creation)
  farmLocation               String?
  areaPlanted                Float?
  plantingMethod             PlantingMethod?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  account                    Account          @relation(fields: [accountId], references: [id])
  admin                      Account?         @relation("AdminTransactions", fields: [adminId], references: [id])
  itemStack                  ItemStack        @relation(fields: [itemStackId], references: [id])
  plantingReport             PlantingReport?  @relation(fields: [plantingReportId], references: [id])

  @@index([accountId], map: "item_transactions_accountId_fkey")
  @@index([adminId], map: "item_transactions_adminId_fkey")
  @@index([itemStackId], map: "item_transactions_itemStackId_fkey")
  @@index([status, returnDate])
  @@index([actual_pickup])
  @@index([actual_return])
  @@map("item_transactions")
}

enum transaction_status {
  Pending
  Approved
  Borrowed
  late_pickup
  Rejected
  Returned
  No_Return
  late_return
  No_Pickup
  Cancelled
  Picked_Up    // Distribution: Seedling picked up on time
  Planted      // Distribution: Planting report submitted
  Archived     // Distribution: Report archived by admin
}

enum item_status {
  Available
  Unavailable
  Damaged
  EIC
  Distributed
  Reserved
}

enum item_category {
  Farming_Equipment
  Harvesting_Tools
  Irrigation_Systems
  Storage_Equipment
  Processing_Equipment
  Safety_Gear
  Pest_Control
  Livestock_Equipment
  Measuring_Tools
  Fisheries
  Machinery
  Seeds            // NEW: For seedling distribution
  Other
}
