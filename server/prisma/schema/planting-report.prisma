// Planting Report System - Complete Redesign
// Tracks planting and harvesting information for farmers

model PlantingReport {
  id String @id @default(cuid())

  // Farmer Information
  farmerName   String
  farmLocation String
  rsbsaNumber  String? // Optional RSBSA Number

  // Seeding Information
  croppingSeasonId   String?
  areaPlanted        Float // in hectares (required from farmer request)
  seedClassification SeedClassification
  typeOfCrop         CropType
  riceIrrigation     riceIrrigation? // Specific irrigation type if typeOfCrop is Rice
  varietyId          String
  dateOfPlanting     DateTime?
  plantingMethod     PlantingMethod?   // Optional in State 1; required when transitioning to State 2
  cropInsurance      Boolean            @default(false) // Crop insurance application checkbox

  // Harvesting Information (admin-managed, optional until harvest is done)
  harvestArea           Float? // in hectares
  numberOfBags          Int?
  weightPerBag          Float? // in kg
  yieldMtPerHa          Float? // Yield in mt/ha (metric tons per hectare)
  dateOfExpectedHarvest DateTime?

  // Distribution linkage / metadata
  distributionRequestId  String?
  distributionItemId     String?
  distributionQuantity   Int?
  distributionUnit       String?
  distributedQuantity    Float? // Track original distributed amount for comparison
  distributionPickupDate DateTime?
  requestNote            String?
  plantingReportDeadline DateTime?

  // System fields
  // NEW: Three-state workflow
  state        PlantingReportState  @default(Request_Report)

  // Archive system (separate from state)
  isArchived   Boolean              @default(false)
  archivedAt   DateTime?
  archivedBy   String?              // Account ID of user who archived

  // Soft Delete (30-day recovery period)
  isDeleted    Boolean              @default(false)
  deletedAt    DateTime?
  deletedBy    String?              // Account ID of user who deleted

  lastUpdatedBy String? // account id of last editor
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  // Audit Trail
  stateHistory Json?                // Tracks all state transitions with timestamps and users

  // Relations
  croppingSeason   PlantingSeason?    @relation(fields: [croppingSeasonId], references: [id], onDelete: Restrict)
  variety          SeedVariety        @relation(fields: [varietyId], references: [id], onDelete: Restrict)
  itemTransactions ItemTransaction[] // Reverse relation for seedling distributions

  // Indexes for optimized queries
  @@index([state, isArchived, isDeleted])  // Primary filtering index
  @@index([distributionRequestId])         // Distribution lookups
  @@index([isDeleted, deletedAt])          // Cleanup job queries
  @@index([state, typeOfCrop])             // Filtered state queries
  @@index([createdAt])                     // Sorting by date
  @@index([varietyId])                     // Variety-based queries
  @@index([croppingSeasonId])              // Season-based queries
  @@map("planting_reports")
}

// Planting Season Reference Table
model PlantingSeason {
  id              String           @id @default(cuid())
  name            String           @unique // e.g., "Wet Season 2024", "Dry Season 2025"
  description     String?
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  plantingReports PlantingReport[]

  @@index([isActive])
  @@index([startDate, endDate])
  @@map("planting_seasons")
}

// Seed Variety Reference Table
model SeedVariety {
  id              String            @id @default(cuid())
  name            String // e.g., "NSIC Rc222", "Pioneer 30G87"
  cropType        CropType
  directSeededDAS Int // Days After Sowing
  transplantedDAS Int // Days After Sowing
  description     String?           @db.Text
  plantingWindow  Int               @default(30) // Days until must be planted (for distributions)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  plantingReports PlantingReport[]
  inventoryItems  InventoryItem[]   // Reverse relation for seedling items

  @@unique([name, cropType]) // Prevent duplicate varieties for same crop
  @@index([cropType, isActive])
  @@map("seed_varieties")
}

// Enumerations

enum riceIrrigation {
  Irrigated
  RainfedLowland @map("Rainfed Lowland")
}

enum SeedClassification {
  Inbred_Certified
  Hybrid_F1
  Inbred_Good
  Inbred_Farmers
}

enum CropType {
  Rice
  Corn
  High_Value_Crops
}

enum PlantingMethod {
  Direct_Seeded
  Transplanting
}

// ==================== NEW: Four-State System ====================
// States: Distributed/Planting → Planted → Harvested
enum PlantingReportState {
  Distributed  // From distribution - seed distributed to farmer
  Planting     // Manual creation - awaiting planting
  Planted      // Crop has been planted
  Harvested    // Crop has been harvested with complete data
}
