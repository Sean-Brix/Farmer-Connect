model CropGuideline {
  id                  String                 @id @default(cuid())
  name                String                 @unique
  category            CropCategory
  varieties           String                 @db.LongText // JSON array of strings
  plantingSeasons     String                 @db.LongText // JSON array of strings
  growingPeriod       String // e.g., "120-140 days", "3-5 years"
  waterRequirements   String // e.g., "High", "Moderate", "Low"
  expectedYield       String // e.g., "4-6 tons/hectare", "15-20 tons/hectare"
  soilType            String
  climate             String
  spacing             String
  fertilizer          String
  keyTips             String                 @db.LongText // JSON array of strings
  commonPests         String                 @db.LongText // JSON array of objects with name and control
  diseases            String                 @db.LongText // JSON array of objects with name and symptoms
  marketPrice         String
  profitability       ProfitabilityRating
  difficulty          DifficultyLevel
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  stages              CropGuidelineStage[]
  registeredCrops     RegisteredCrop[]

  @@index([category, isActive])
  @@map("crop_guidelines")
}

model CropGuidelineStage {
  id              String        @id @default(cuid())
  guidelineId     String
  stageName       String // e.g., "Land Preparation", "Seedling", "Vegetative"
  duration        String // e.g., "2-3 weeks", "21-25 days", "40-50 days"
  description     String        @db.Text
  activities      String        @db.LongText // JSON array of strings
  sequenceOrder   Int // Order of the stage in the growth cycle
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  guideline       CropGuideline @relation(fields: [guidelineId], references: [id], onDelete: Cascade)

  @@index([guidelineId, sequenceOrder])
  @@map("crop_guideline_stages")
}

enum CropCategory {
  Cereals
  Vegetables
  Fruits
  Legumes
  Root_Crops
  Herbs_Spices
}

enum ProfitabilityRating {
  Low
  Moderate
  High
  Very_High
}

enum DifficultyLevel {
  Easy
  Moderate
  Moderate_High
  High
}
