model ChatRoom {
  id           String            @id @default(cuid())
  name         String?
  isGroup      Boolean           @default(false)
  roomType     RoomType          @default(DIRECT)
  isActive     Boolean           @default(true)
  lastActivity DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     ChatMessage[]
  participants ChatParticipant[]

  @@index([isActive])
  @@index([lastActivity])
  @@index([roomType])
  @@map("chat_rooms")
}

model ChatParticipant {
  id          String          @id @default(cuid())
  userId      String
  roomId      String
  role        ParticipantRole @default(MEMBER)
  isActive    Boolean         @default(true)
  lastSeen    DateTime        @default(now())
  unreadCount Int             @default(0)
  joinedAt    DateTime        @default(now())
  room        ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        Account         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
  @@map("chat_participants")
}

model ChatMessage {
  id           String            @id @default(cuid())
  content      String            @db.LongText
  messageType  MessageType       @default(TEXT)
  senderId     String
  roomId       String
  isEdited     Boolean           @default(false)
  isDeleted    Boolean           @default(false)
  replyToId    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  attachments  ChatAttachment[]
  replyTo      ChatMessage?      @relation("MessageReply", fields: [replyToId], references: [id])
  replies      ChatMessage[]     @relation("MessageReply")
  room         ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender       Account           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  readReceipts ChatReadReceipt[]

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([replyToId], map: "chat_messages_replyToId_fkey")
  @@map("chat_messages")
}

model ChatAttachment {
  id           String      @id @default(cuid())
  filename     String
  filepath     String
  filesize     Int
  mimetype     String
  messageId    String
  uploadedById String
  createdAt    DateTime    @default(now())
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy   Account     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploadedById], map: "chat_attachments_uploadedById_fkey")
  @@map("chat_attachments")
}

model ChatReadReceipt {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      Account     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("chat_read_receipts")
}

enum RoomType {
  DIRECT
  GROUP
  SUPPORT
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}
