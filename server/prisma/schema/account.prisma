model Account {
  id                      String               @id @default(cuid())
  access                  access               @default(User)
  username                String               @unique
  email                   String               @unique
  password                String
  firstName               String
  middleName              String?
  surname                 String
  extensionName           String?
  sex                     gender               @default(Other)
  street                  String?
  barangay                String?
  municipality            String?
  province                String?
  region                  String?
  houseNumber             String?
  mobileNumber            String?
  landlineNumber          String?
  birthMunicipality       String?
  birthProvince           String?
  birthCountry            String?
  dateOfBirth             DateTime?
  religion                String?
  otherReligionSpecify    String?
  civilStatus             String?
  spouseName              String?
  femaleHouseholdMembers  String?
  maleHouseholdMembers    String?
  isHouseholdHead         Boolean?
  householdHeadName       String?
  relationshipToHead      RelationshipToHead?
  hasGovId                Boolean?
  govIdType               GovIdType?
  govIdNumber             String?
  education               EducationLevel?
  isPWD                   Boolean?
  disabilityType          String?
  livelihoodProfile       String?              @db.LongText
  farmingActivities       String?              @db.LongText
  fishingActivities       String?              @db.LongText
  farmworkActivities      String?              @db.LongText
  youthActivities         String?              @db.LongText
  otherCropsSpecify       String?
  livestockSpecify        String?
  fishingOthersSpecify    String?
  farmworkOthersSpecify   String?
  youthOthersSpecify      String?
  grossAnnualIncome       String?
  incomeSource            IncomeSource?
  picture                 Bytes?
  mimeType                String?
  resetTokenHash          String?
  resetTokenExpiry        DateTime?
  client_profile          client_profile       @default(Other)
  address                 String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  auditLogs               AuditLog[]           @relation("AdminAuditLogs")
  chatAttachments         ChatAttachment[]
  chatMessages            ChatMessage[]
  chatParticipants        ChatParticipant[]
  chatReadReceipts        ChatReadReceipt[]
  createdFAQCategories    FAQCategory[]
  createdFAQs             FAQ[]
  assignedInquiries       Inquiry[]            @relation("AssignedInquiries")
  resolvedInquiries       Inquiry[]            @relation("ResolvedInquiries")
  inquiries               Inquiry[]
  inquiryAttachments      InquiryAttachment[]
  inquiryReplies          InquiryReply[]
  itemTransactions        ItemTransaction[]
  adminTransactions       ItemTransaction[]    @relation("AdminTransactions")
  registeredCrops         RegisteredCrop[]
  seminars                SeminarParticipant[]
  seminarsCreated         Seminar[]            @relation("SeminarsCreated")
  surveyFormsCreated      SurveyForm[]         @relation("SurveyFormsCreated")
  surveyResponses         SurveyResponse[]     @relation("SurveyResponses")
  surveyStatisticsCreated SurveyStatistic[]    @relation("SurveyStatisticsCreated")
  preferences             UserPreference[]

  @@map("accounts")
}

enum RelationshipToHead {
  Son
  Daughter
  Spouse
  Father
  Mother
  Brother
  Sister
  Grandchild
  Son_in_law      @map("Son-in-law")
  Daughter_in_law @map("Daughter-in-law")
  Other_relative  @map("Other relative")
}

enum GovIdType {
  National_ID       @map("National ID")
  Drivers_License   @map("Drivers License")
  Passport
  Voters_ID         @map("Voters ID")
  School_ID         @map("School ID")
  SSS_ID            @map("SSS ID")
  PhilHealth_ID     @map("PhilHealth ID")
  TIN_ID            @map("TIN ID")
  PRC_ID            @map("PRC ID")
  Senior_Citizen_ID @map("Senior Citizen ID")
  PWD_ID            @map("PWD ID")
  Other
}

enum EducationLevel {
  No_formal_education         @map("No formal education")
  Kinder
  Elementary_level            @map("Elementary level")
  Elementary_graduate         @map("Elementary graduate")
  High_school_level           @map("High school level")
  High_school_graduate        @map("High school graduate")
  Senior_high_school_level    @map("Senior high school level")
  Senior_high_school_graduate @map("Senior high school graduate")
  College_level               @map("College level")
  College_graduate            @map("College graduate")
  Post_graduate_studies       @map("Post-graduate studies")
  Vocational_Technical        @map("Vocational/Technical")
}

enum IncomeSource {
  farming
  non_farming @map("non-farming")
}

enum client_profile {
  Fishfolk                          @map("Fishfolk")
  Rural_Based_Org                   @map("Rural Based Org")
  Student                           @map("Student")
  Agricultural_Fisheries_Technician @map("Agricultural/Fisheries Technician")
  Youth                             @map("Youth")
  Women                             @map("Women")
  Govt_Employee                     @map("Govt Employee")
  PWD                               @map("PWD")
  Indigenous_People                 @map("Indigenous People")
  Other                             @map("Other")
}

enum access {
  Admin
  User
  Super_Admin @map("Super Admin")
}

enum gender {
  Male
  Female
  Other
}
