model Account {
  id             String         @id @default(cuid())
  firstName      String
  middleName     String?
  surname        String
  extensionName  String?
  sex            sexOption      @default(Male)
  contactNumber  String?
  dateOfBirth    DateTime?
  picturePath    String?
  username       String         @unique
  password       String
  access         access         @default(User)
  email          String?
  client_profile client_profile @default(Other)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  // Relations
  auditLogs               AuditLog[]           @relation("AdminAuditLogs")
  chatAttachments         ChatAttachment[]
  chatMessages            ChatMessage[]
  chatParticipants        ChatParticipant[]
  chatReadReceipts        ChatReadReceipt[]
  createdFAQCategories    FAQCategory[]
  createdFAQs             FAQ[]
  assignedInquiries       Inquiry[]            @relation("AssignedInquiries")
  resolvedInquiries       Inquiry[]            @relation("ResolvedInquiries")
  inquiries               Inquiry[]
  inquiryAttachments      InquiryAttachment[]
  inquiryReplies          InquiryReply[]
  itemTransactions        ItemTransaction[]
  adminTransactions       ItemTransaction[]    @relation("AdminTransactions")
  seminars                SeminarParticipant[]
  seminarsCreated         Seminar[]            @relation("SeminarsCreated")
  surveyFormsCreated      SurveyForm[]         @relation("SurveyFormsCreated")
  surveyResponses         SurveyResponse[]     @relation("SurveyResponses")
  surveyStatisticsCreated SurveyStatistic[]    @relation("SurveyStatisticsCreated")
  preferences             UserPreference[]
  notifications           Notification[]
  notificationSettings    NotificationSettings?
  systemSettingsUpdated   SystemSettings[]     @relation("SystemSettingsUpdater")
  distributionHistory     DistributionHistory[]
  distributionWaitlist    DistributionWaitlist[]

  @@map("accounts")
}

enum sexOption {
  Male
  Female
}

enum client_profile {
  Fishfolk                          @map("Fishfolk")
  Rural_Based_Org                   @map("Rural Based Org")
  Student                           @map("Student")
  Agricultural_Fisheries_Technician @map("Agricultural/Fisheries Technician")
  Youth                             @map("Youth")
  Women                             @map("Women")
  Govt_Employee                     @map("Govt Employee")
  PWD                               @map("PWD")
  Indigenous_People                 @map("Indigenous People")
  Other                             @map("Other")
}

enum access {
  Admin
  User
  Super_Admin @map("Super Admin")
}
