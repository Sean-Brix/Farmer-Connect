generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                      String                 @id @default(cuid())
  firstName               String
  middleName              String?
  surname                 String
  extensionName           String?
  sex                     sexOption              @default(Male)
  contactNumber           String?
  dateOfBirth             DateTime?
  picturePath             String?
  username                String                 @unique
  password                String
  access                  access                 @default(User)
  email                   String?
  client_profile          client_profile         @default(Other)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  resetTokenExpiry        DateTime?
  resetTokenHash          String?
  auditLogs               AuditLog[]             @relation("AdminAuditLogs")
  chatAttachments         ChatAttachment[]
  chatMessages            ChatMessage[]
  chatParticipants        ChatParticipant[]
  chatReadReceipts        ChatReadReceipt[]
  distributionHistory     DistributionHistory[]
  distributionWaitlist    DistributionWaitlist[]
  createdFAQCategories    FAQCategory[]
  createdFAQs             FAQ[]
  assignedInquiries       Inquiry[]              @relation("AssignedInquiries")
  resolvedInquiries       Inquiry[]              @relation("ResolvedInquiries")
  inquiries               Inquiry[]
  inquiryAttachments      InquiryAttachment[]
  inquiryReplies          InquiryReply[]
  itemTransactions        ItemTransaction[]
  adminTransactions       ItemTransaction[]      @relation("AdminTransactions")
  notificationSettings    NotificationSettings?
  notifications           Notification[]
  seminars                SeminarParticipant[]
  seminarsCreated         Seminar[]              @relation("SeminarsCreated")
  surveyFormsCreated      SurveyForm[]           @relation("SurveyFormsCreated")
  surveyResponses         SurveyResponse[]       @relation("SurveyResponses")
  surveyStatisticsCreated SurveyStatistic[]      @relation("SurveyStatisticsCreated")
  systemSettingsUpdated   SystemSettings[]       @relation("SystemSettingsUpdater")
  preferences             UserPreference[]

  @@map("accounts")
}

model AuditLog {
  id         String       @id @default(cuid())
  adminId    String
  action     audit_action
  targetType String?
  targetId   String?
  targetName String?
  details    String?      @db.Text
  metadata   String?      @db.LongText
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())
  admin      Account      @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([adminId], map: "audit_logs_adminId_fkey")
  @@index([createdAt])
  @@index([action])
  @@index([targetType])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ChatRoom {
  id           String            @id @default(cuid())
  name         String?
  isGroup      Boolean           @default(false)
  roomType     RoomType          @default(DIRECT)
  isActive     Boolean           @default(true)
  lastActivity DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     ChatMessage[]
  participants ChatParticipant[]

  @@index([isActive])
  @@index([lastActivity])
  @@index([roomType])
  @@map("chat_rooms")
}

model ChatParticipant {
  id          String          @id @default(cuid())
  userId      String
  roomId      String
  role        ParticipantRole @default(MEMBER)
  isActive    Boolean         @default(true)
  lastSeen    DateTime        @default(now())
  unreadCount Int             @default(0)
  joinedAt    DateTime        @default(now())
  room        ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        Account         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
  @@map("chat_participants")
}

model ChatMessage {
  id           String            @id @default(cuid())
  content      String            @db.LongText
  messageType  MessageType       @default(TEXT)
  senderId     String
  roomId       String
  isEdited     Boolean           @default(false)
  isDeleted    Boolean           @default(false)
  replyToId    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  attachments  ChatAttachment[]
  replyTo      ChatMessage?      @relation("MessageReply", fields: [replyToId], references: [id])
  replies      ChatMessage[]     @relation("MessageReply")
  room         ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender       Account           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  readReceipts ChatReadReceipt[]

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([replyToId], map: "chat_messages_replyToId_fkey")
  @@map("chat_messages")
}

model ChatAttachment {
  id           String      @id @default(cuid())
  filename     String
  filepath     String
  filesize     Int
  mimetype     String
  messageId    String
  uploadedById String
  createdAt    DateTime    @default(now())
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy   Account     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploadedById], map: "chat_attachments_uploadedById_fkey")
  @@map("chat_attachments")
}

model ChatReadReceipt {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      Account     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("chat_read_receipts")
}

model DistributionQuota {
  id                  String    @id @default(cuid())
  itemStackId         String    @unique
  maxPerUser          Int       @default(1)
  maxRequestsPerMonth Int       @default(1)
  cooldownDays        Int       @default(30)
  eligibilityCriteria String?   @db.LongText
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  itemStack           ItemStack @relation(fields: [itemStackId], references: [id], onDelete: Cascade)

  @@index([itemStackId])
  @@index([active])
  @@map("distribution_quotas")
}

model DistributionHistory {
  id            String    @id @default(cuid())
  accountId     String
  itemStackId   String
  quantity      Int
  receivedAt    DateTime  @default(now())
  transactionId String?
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  itemStack     ItemStack @relation(fields: [itemStackId], references: [id], onDelete: Cascade)

  @@index([accountId, itemStackId])
  @@index([accountId, receivedAt])
  @@index([itemStackId])
  @@map("distribution_history")
}

model DistributionWaitlist {
  id          String    @id @default(cuid())
  accountId   String
  itemStackId String
  quantity    Int       @default(1)
  position    Int
  notified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  itemStack   ItemStack @relation(fields: [itemStackId], references: [id], onDelete: Cascade)

  @@unique([accountId, itemStackId])
  @@index([itemStackId, position])
  @@index([expiresAt])
  @@index([notified])
  @@map("distribution_waitlist")
}

model Inquiry {
  id           String              @id @default(cuid())
  subject      String
  message      String              @db.LongText
  status       InquiryStatus       @default(PENDING)
  userId       String
  guestName    String?
  guestEmail   String?
  assignedToId String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  assignedTo   Account?            @relation("AssignedInquiries", fields: [assignedToId], references: [id])
  resolvedBy   Account?            @relation("ResolvedInquiries", fields: [resolvedById], references: [id])
  user         Account             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments  InquiryAttachment[]
  replies      InquiryReply[]

  @@index([status])
  @@index([userId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, updatedAt])
  @@index([resolvedById], map: "inquiries_resolvedById_fkey")
  @@map("inquiries")
}

model InquiryReply {
  id            String         @id @default(cuid())
  message       String         @db.LongText
  senderId      String?
  senderType    SenderType
  senderName    String?
  inquiryId     String
  parentReplyId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  readByUser    Boolean        @default(false)
  readByAdmin   Boolean        @default(false)
  readAt        DateTime?
  inquiry       Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  parentReply   InquiryReply?  @relation("ReplyThread", fields: [parentReplyId], references: [id])
  childReplies  InquiryReply[] @relation("ReplyThread")
  sender        Account?       @relation(fields: [senderId], references: [id])

  @@index([inquiryId])
  @@index([senderId])
  @@index([createdAt])
  @@index([senderType])
  @@index([readByAdmin, senderType])
  @@index([readByUser, senderType])
  @@index([parentReplyId], map: "inquiry_replies_parentReplyId_fkey")
  @@map("inquiry_replies")
}

model InquiryAttachment {
  id           String   @id @default(cuid())
  filename     String
  filepath     String?
  filesize     Int
  mimetype     String
  fileData     Bytes?
  inquiryId    String
  uploadedById String?
  createdAt    DateTime @default(now())
  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  uploadedBy   Account? @relation(fields: [uploadedById], references: [id])

  @@index([inquiryId])
  @@index([uploadedById], map: "inquiry_attachments_uploadedById_fkey")
  @@map("inquiry_attachments")
}

model FAQCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Account? @relation(fields: [createdById], references: [id])
  faqs        FAQ[]

  @@index([isActive])
  @@index([orderIndex])
  @@index([createdById], map: "faq_categories_createdById_fkey")
  @@map("faq_categories")
}

model FAQ {
  id           String       @id @default(cuid())
  question     String
  answer       String       @db.LongText
  isActive     Boolean      @default(true)
  orderIndex   Int          @default(0)
  createdById  String?
  viewCount    Int          @default(0)
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  categoryId   String?
  category     FAQCategory? @relation(fields: [categoryId], references: [id])
  createdBy    Account?     @relation(fields: [createdById], references: [id])

  @@index([isActive])
  @@index([orderIndex])
  @@index([categoryId])
  @@index([createdById], map: "faqs_createdById_fkey")
  @@map("faqs")
}

model InventoryItem {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?
  picture       Bytes?
  category      item_category @default(Other)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  seedVarietyId String?
  unit          String?
  seedVariety   SeedVariety?  @relation(fields: [seedVarietyId], references: [id])
  item_stacks   ItemStack[]

  @@index([seedVarietyId], map: "inventory_items_seedVarietyId_fkey")
  @@map("inventory_items")
}

model ItemStack {
  id                       String                 @id @default(cuid())
  itemId                   String
  quantity                 Int                    @default(1)
  status                   item_status            @default(Available)
  date_limit               Int?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  max_quantity_per_request Int?
  reservedQuantity         Int                    @default(0)
  distributionHistory      DistributionHistory[]
  distributionQuota        DistributionQuota?
  distributionWaitlist     DistributionWaitlist[]
  item                     InventoryItem          @relation(fields: [itemId], references: [id])
  itemTransactions         ItemTransaction[]

  @@index([itemId], map: "item_stacks_itemId_fkey")
  @@map("item_stacks")
}

model ItemTransaction {
  id                        String             @id @default(cuid())
  itemStackId               String
  accountId                 String
  adminId                   String?
  quantity                  Int                @default(1)
  status                    transaction_status @default(Pending)
  pickupDate                DateTime
  returnDate                DateTime?
  requestNote               String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  autoStatusChanged         Boolean            @default(false)
  statusChangeReason        String?
  statusChangedAt           DateTime?
  actual_pickup             DateTime?
  actual_return             DateTime?
  previousStatus            String?
  adjustedReturnDate        DateTime?
  plantingReportArchivedAt  DateTime?
  plantingReportDeadline    DateTime?
  plantingReportId          String?
  plantingReportRequired    Boolean            @default(false)
  plantingReportSubmittedAt DateTime?
  areaPlanted               Float?
  farmLocation              String?
  plantingMethod            PlantingMethod?
  account                   Account            @relation(fields: [accountId], references: [id])
  admin                     Account?           @relation("AdminTransactions", fields: [adminId], references: [id])
  itemStack                 ItemStack          @relation(fields: [itemStackId], references: [id])
  plantingReport            PlantingReport?    @relation(fields: [plantingReportId], references: [id])

  @@index([accountId], map: "item_transactions_accountId_fkey")
  @@index([adminId], map: "item_transactions_adminId_fkey")
  @@index([itemStackId], map: "item_transactions_itemStackId_fkey")
  @@index([status, returnDate])
  @@index([actual_pickup])
  @@index([actual_return])
  @@index([plantingReportId], map: "item_transactions_plantingReportId_fkey")
  @@map("item_transactions")
}

model Notification {
  id        String            @id @default(cuid())
  accountId String
  type      notification_type
  title     String
  message   String            @db.Text
  relatedId String?
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, read])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationSettings {
  id              String  @id @default(cuid())
  accountId       String  @unique
  emailEnabled    Boolean @default(true)
  requestApproved Boolean @default(true)
  requestRejected Boolean @default(true)
  itemDueSoon     Boolean @default(true)
  itemOverdue     Boolean @default(true)
  seminarReminder Boolean @default(true)
  account         Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model PlantingReport {
  id                     String              @id @default(cuid())
  farmerName             String
  farmLocation           String
  rsbsaNumber            String?
  croppingSeasonId       String?
  areaPlanted            Float
  seedClassification     SeedClassification
  typeOfCrop             CropType
  riceIrrigation         riceIrrigation?
  varietyId              String
  dateOfPlanting         DateTime?
  plantingMethod         PlantingMethod?
  cropInsurance          Boolean             @default(false)
  harvestArea            Float?
  numberOfBags           Int?
  weightPerBag           Float?
  yieldMtPerHa           Float?
  dateOfExpectedHarvest  DateTime?
  isArchived             Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  distributionItemId     String?
  distributionPickupDate DateTime?
  distributionQuantity   Int?
  distributionRequestId  String?
  distributionUnit       String?
  lastUpdatedBy          String?
  plantingReportDeadline DateTime?
  requestNote            String?
  archivedAt             DateTime?
  archivedBy             String?
  deletedAt              DateTime?
  deletedBy              String?
  distributedQuantity    Float?
  isDeleted              Boolean             @default(false)
  state                  PlantingReportState @default(Planting)
  stateHistory           String?             @db.LongText
  itemTransactions       ItemTransaction[]
  croppingSeason         PlantingSeason?     @relation(fields: [croppingSeasonId], references: [id], onDelete: Restrict)
  variety                SeedVariety         @relation(fields: [varietyId], references: [id])

  @@index([state, isArchived, isDeleted])
  @@index([distributionRequestId])
  @@index([isDeleted, deletedAt])
  @@index([state, typeOfCrop])
  @@index([createdAt])
  @@index([varietyId])
  @@index([croppingSeasonId])
  @@map("planting_reports")
}

model PlantingSeason {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  plantingReports PlantingReport[]

  @@index([isActive])
  @@index([startDate, endDate])
  @@map("planting_seasons")
}

model SeedVariety {
  id              String           @id @default(cuid())
  name            String
  cropType        CropType
  directSeededDAS Int
  transplantedDAS Int
  description     String?          @db.Text
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  plantingWindow  Int              @default(30)
  inventoryItems  InventoryItem[]
  plantingReports PlantingReport[]

  @@unique([name, cropType])
  @@index([cropType, isActive])
  @@map("seed_varieties")
}

model UserPreference {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      Account  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_preferences")
}

model Seminar {
  id                    String               @id @default(cuid())
  title                 String
  description           String               @db.Text
  location              String
  speaker               String
  start_date            DateTime             @db.Date
  end_date              DateTime             @db.Date
  start_time            String
  end_time              String
  capacity              Int
  registration_deadline DateTime             @db.Date
  status                seminar_status       @default(Upcoming)
  picture               Bytes?
  mimeType              String?
  createdById           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  participants          SeminarParticipant[]
  creator               Account              @relation("SeminarsCreated", fields: [createdById], references: [id])

  @@index([createdById], map: "seminars_createdById_fkey")
  @@map("seminars")
}

model SeminarParticipant {
  id         String             @id @default(cuid())
  seminar_id String
  account_id String
  status     participant_status @default(Registered)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @default(now()) @updatedAt
  account    Account            @relation(fields: [account_id], references: [id])
  seminar    Seminar            @relation(fields: [seminar_id], references: [id])

  @@unique([seminar_id, account_id])
  @@index([account_id], map: "seminar_participants_account_id_fkey")
  @@map("seminar_participants")
}

model SurveyForm {
  id          String            @id @default(cuid())
  title       String
  description String?           @db.Text
  status      survey_status     @default(DRAFT)
  category    String
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  fields      SurveyField[]
  creator     Account           @relation("SurveyFormsCreated", fields: [createdById], references: [id])
  responses   SurveyResponse[]
  statistics  SurveyStatistic[] @relation("SurveyStatistics")

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([status, category])
  @@index([createdById], map: "survey_forms_createdById_fkey")
  @@map("survey_forms")
}

model SurveyField {
  id           String         @id @default(cuid())
  surveyFormId String
  type         field_type
  label        String
  placeholder  String?
  required     Boolean        @default(false)
  options      String?        @db.LongText
  order        Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  answers      SurveyAnswer[]
  surveyForm   SurveyForm     @relation(fields: [surveyFormId], references: [id], onDelete: Cascade)

  @@index([surveyFormId], map: "survey_fields_surveyFormId_fkey")
  @@map("survey_fields")
}

model SurveyResponse {
  id           String         @id @default(cuid())
  surveyFormId String
  userId       String?
  submittedAt  DateTime       @default(now())
  metadata     String?        @db.LongText
  answers      SurveyAnswer[]
  surveyForm   SurveyForm     @relation(fields: [surveyFormId], references: [id], onDelete: Cascade)
  user         Account?       @relation("SurveyResponses", fields: [userId], references: [id])

  @@index([surveyFormId])
  @@index([submittedAt])
  @@index([surveyFormId], map: "survey_responses_surveyFormId_fkey")
  @@index([userId], map: "survey_responses_userId_fkey")
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  fieldId    String
  answer     String         @db.LongText
  createdAt  DateTime       @default(now())
  field      SurveyField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, fieldId])
  @@index([fieldId], map: "survey_answers_fieldId_fkey")
  @@map("survey_answers")
}

model SurveyStatistic {
  id           String     @id @default(cuid())
  surveyFormId String
  chartType    chart_type
  title        String
  description  String?    @db.Text
  config       String     @db.LongText
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  creator      Account    @relation("SurveyStatisticsCreated", fields: [createdById], references: [id])
  surveyForm   SurveyForm @relation("SurveyStatistics", fields: [surveyFormId], references: [id], onDelete: Cascade)

  @@index([createdById], map: "survey_statistics_createdById_fkey")
  @@index([surveyFormId], map: "survey_statistics_surveyFormId_fkey")
  @@map("survey_statistics")
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  category    String   @default("general")
  dataType    String   @default("string")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updater     Account? @relation("SystemSettingsUpdater", fields: [updatedBy], references: [id])

  @@index([category])
  @@index([updatedBy], map: "system_settings_updatedBy_fkey")
  @@map("system_settings")
}

enum sexOption {
  Male
  Female
}

enum client_profile {
  Fishfolk                          @map("Fishfolk")
  Rural_Based_Org                   @map("Rural Based Org")
  Student                           @map("Student")
  Agricultural_Fisheries_Technician @map("Agricultural/Fisheries Technician")
  Youth                             @map("Youth")
  Women                             @map("Women")
  Govt_Employee                     @map("Govt Employee")
  PWD                               @map("PWD")
  Indigenous_People                 @map("Indigenous People")
  Other                             @map("Other")
}

enum access {
  Admin
  User
  Super_Admin @map("Super Admin")
}

enum audit_action {
  ACCOUNT_CREATE
  ACCOUNT_UPDATE
  ACCOUNT_DELETE
  ACCOUNT_ROLE_CHANGE
  ACCOUNT_STATUS_CHANGE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  INVENTORY_CREATE
  INVENTORY_UPDATE
  INVENTORY_DELETE
  INVENTORY_STATUS_CHANGE
  DISTRIBUTION_CREATE
  DISTRIBUTION_UPDATE
  DISTRIBUTION_DELETE
  DISTRIBUTION_REQUEST_APPROVE
  DISTRIBUTION_REQUEST_REJECT
  DISTRIBUTION_REQUEST_NO_PICKUP
  EIC_CREATE
  EIC_UPDATE
  EIC_DELETE
  EIC_STATUS_CHANGE
  EIC_REQUEST_APPROVE
  EIC_REQUEST_REJECT
  EIC_REQUEST_NO_PICKUP
  SEMINAR_CREATE
  SEMINAR_UPDATE
  SEMINAR_DELETE
  SEMINAR_STATUS_CHANGE
  SEMINAR_PARTICIPANT_UPDATE
  CONTENT_CREATE
  CONTENT_UPDATE
  CONTENT_DELETE
  SYSTEM_BACKUP
  SYSTEM_RESTORE
  SYSTEM_MAINTENANCE
  PROFILE_UPDATE
  PROFILE_PICTURE_UPDATE
  SETTINGS_UPDATE
  INQUIRY_CREATE
  INQUIRY_REPLY
  INQUIRY_ASSIGN
  INQUIRY_RESOLVE
  INQUIRY_ATTACHMENT_UPLOAD
  SURVEY_FORM_CREATE
  SURVEY_FORM_UPDATE
  SURVEY_FORM_DELETE
  SURVEY_RESPONSE_SUBMIT
