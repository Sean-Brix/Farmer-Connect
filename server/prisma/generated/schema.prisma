//? ===================================== ACCOUNTS SCHEMA ===================================== ?//

model Account {
  id       String @id @default(cuid())
  access   access @default(User)
  username String @unique
  email    String @unique
  password String

  // Personal Information
  firstName     String
  middleName    String?
  surname       String
  extensionName String? // Jr., Sr., III, etc.
  sex           gender  @default(Other)

  // Address Information
  street       String?
  barangay     String?
  municipality String?
  province     String?
  region       String?
  houseNumber  String?

  // Contact Information
  mobileNumber   String? // Renamed from cellphone_no
  landlineNumber String? // Renamed from telephone_no

  // Birth Information
  birthMunicipality String? // New field for place of birth
  birthProvince     String? // New field for birth province
  birthCountry      String? // New field for birth country
  dateOfBirth       DateTime? // New field

  // Personal Details
  religion             String?
  otherReligionSpecify String? // For when religion is "Others"
  civilStatus          String?
  spouseName           String?

  // Household Information
  femaleHouseholdMembers String?
  maleHouseholdMembers   String?
  isHouseholdHead        Boolean? // Changed from String to Boolean
  householdHeadName      String? // If not household head
  relationshipToHead     RelationshipToHead? // Enum for relationship types

  // Government ID Information
  hasGovId    Boolean? // Changed from String to Boolean
  govIdType   GovIdType? // Enum for government ID types
  govIdNumber String? // Government ID number

  // Education
  education EducationLevel? // Enum for education levels

  // PWD Information
  isPWD          Boolean? // Changed from String to Boolean
  disabilityType String? // Type of disability if PWD

  // Livelihood Profile (stored as JSON arrays)
  livelihoodProfile  Json? // Array of livelihood types
  farmingActivities  Json? // Array of farming activities
  fishingActivities  Json? // Array of fishing activities
  farmworkActivities Json? // Array of farmwork activities
  youthActivities    Json? // Array of youth activities

  // Livelihood Specifications
  otherCropsSpecify     String?
  livestockSpecify      String?
  fishingOthersSpecify  String?
  farmworkOthersSpecify String?
  youthOthersSpecify    String?

  // Income Information
  grossAnnualIncome String?
  incomeSource      IncomeSource? // Enum for farming/non-farming

  // Profile Photo
  picture  Bytes?
  mimeType String?

  // Legacy fields (kept for compatibility)
  client_profile client_profile @default(Other)
  address        String? // Legacy address field
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  seminars          SeminarParticipant[]
  itemTransactions  ItemTransaction[]
  adminTransactions ItemTransaction[]    @relation("AdminTransactions")
  seminarsCreated   Seminar[]            @relation("SeminarsCreated")
  auditLogs         AuditLog[]           @relation("AdminAuditLogs")

  // Inquiry System Relations
  inquiries          Inquiry[] // User's own inquiries
  assignedInquiries  Inquiry[]           @relation("AssignedInquiries")
  resolvedInquiries  Inquiry[]           @relation("ResolvedInquiries")
  inquiryReplies     InquiryReply[]
  inquiryAttachments InquiryAttachment[]
  createdFAQs        FAQ[]

  // Chat System Relations
  chatParticipants ChatParticipant[]
  chatMessages     ChatMessage[]
  chatAttachments  ChatAttachment[]
  chatReadReceipts ChatReadReceipt[]

  // Survey Forms Relations
  surveyFormsCreated      SurveyForm[]      @relation("SurveyFormsCreated")
  surveyResponses         SurveyResponse[]  @relation("SurveyResponses")
  surveyStatisticsCreated SurveyStatistic[] @relation("SurveyStatisticsCreated")

  // User Preferences Relations
  preferences UserPreference[]

  @@map("accounts")
}

