// Simple Chat System Schema - Facebook Messenger Style
// Clean and simple real-time messaging

model ChatRoom {
  id String @id @default(cuid())

  // Room Information
  name     String? // Optional room name (for group chats)
  isGroup  Boolean  @default(false) // false = direct message, true = group chat
  roomType RoomType @default(DIRECT) // DIRECT or GROUP

  // Room Settings
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  participants ChatParticipant[]
  messages     ChatMessage[]

  // Indexes
  @@index([isActive])
  @@index([lastActivity])
  @@index([roomType])
  @@map("chat_rooms")
}

model ChatParticipant {
  id String @id @default(cuid())

  // Participant Information
  userId String
  user   Account @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Room Relation
  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Participant Settings
  role     ParticipantRole @default(MEMBER) // ADMIN or MEMBER (for group chats)
  isActive Boolean         @default(true)

  // Last seen and notifications
  lastSeen    DateTime @default(now())
  unreadCount Int      @default(0)

  // Timestamps
  joinedAt DateTime @default(now())

  // Unique constraint - one participation per user per room
  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
  @@map("chat_participants")
}

model ChatMessage {
  id String @id @default(cuid())

  // Message Content
  content     String      @db.LongText
  messageType MessageType @default(TEXT) // TEXT, IMAGE, FILE, etc.

  // Sender Information
  senderId String
  sender   Account @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Room Relation
  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Message Status
  isEdited  Boolean @default(false)
  isDeleted Boolean @default(false)

  // Reply/Thread Support (optional)
  replyToId String?
  replyTo   ChatMessage?  @relation("MessageReply", fields: [replyToId], references: [id])
  replies   ChatMessage[] @relation("MessageReply")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attachments  ChatAttachment[]
  readReceipts ChatReadReceipt[]

  // Indexes
  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("chat_messages")
}

model ChatAttachment {
  id String @id @default(cuid())

  // File Information
  filename String
  filepath String
  filesize Int
  mimetype String

  // Message Relation
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Uploader
  uploadedById String
  uploadedBy   Account @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("chat_attachments")
}

model ChatReadReceipt {
  id String @id @default(cuid())

  // Message and User
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   Account @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Read Status
  readAt DateTime @default(now())

  // Unique constraint - one read receipt per user per message
  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("chat_read_receipts")
}

// Enums
enum RoomType {
  DIRECT // 1-on-1 chat
  GROUP // Group chat
  SUPPORT // Support chat (user + admin)
}

enum ParticipantRole {
  ADMIN // Can manage room settings
  MEMBER // Regular participant
}

enum MessageType {
  TEXT // Regular text message
  IMAGE // Image message
  FILE // File attachment
  SYSTEM // System message (user joined, left, etc.)
}

// Inquiry System Schema for FITS-Tanza Chat Support
// Supports: Client chat inquiries, Admin management, FAQ system, Real-time messaging

//    !! REDO THE INQUIRY DATABASE SCHEMAS !!

model Inquiry {
  id String @id @default(cuid())

  // Basic Information
  subject String // Inquiry title/subject
  message String        @db.LongText // Original inquiry message
  status  InquiryStatus @default(PENDING) // Current status

  // User Information (can be guest or registered user)
  userId     String
  user       Account? @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestName  String? // Name for guest users
  guestEmail String? // Email for guest users

  // Assignment & Resolution
  assignedToId String? // Admin assigned to handle this inquiry
  assignedTo   Account?  @relation("AssignedInquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedById String? // Admin who resolved the inquiry
  resolvedBy   Account?  @relation("ResolvedInquiries", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime? // When inquiry was resolved

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  replies     InquiryReply[]
  attachments InquiryAttachment[]

  // Indexes for performance
  @@index([status])
  @@index([userId])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("inquiries")
}

model InquiryReply {
  id String @id @default(cuid())

  // Message Content
  message String @db.LongText

  // Sender Information
  senderId   String? // User/Admin who sent this reply
  sender     Account?   @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderType SenderType // USER, ADMIN, BOT
  senderName String? // Display name (for guest users or admin display names)

  // Inquiry Relation
  inquiryId String // Parent inquiry
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  // Reply Threading (for future nested replies)
  parentReplyId String? // For threaded conversations
  parentReply   InquiryReply?  @relation("ReplyThread", fields: [parentReplyId], references: [id])
  childReplies  InquiryReply[] @relation("ReplyThread")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Read Status (for real-time notifications)
  readByUser  Boolean   @default(false) // User has read this reply
  readByAdmin Boolean   @default(false) // Admin has read this reply
  readAt      DateTime? // When marked as read

  // Indexes
  @@index([inquiryId])
  @@index([senderId])
  @@index([createdAt])
  @@index([senderType])
  @@map("inquiry_replies")
}

model InquiryAttachment {
  id String @id @default(cuid())

  // File Information
  filename String // Original filename
  filepath String // Stored file path
  filesize Int // File size in bytes
  mimetype String // MIME type

  // Relations
  inquiryId String // Parent inquiry
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  uploadedById String? // Who uploaded this file
  uploadedBy   Account? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([inquiryId])
  @@map("inquiry_attachments")
}

model FAQ {
  id String @id @default(cuid())

  // Content
  question String // FAQ question
  answer   String @db.LongText // FAQ answer

  // Management
  isActive   Boolean @default(true) // Whether FAQ is publicly visible
  orderIndex Int     @default(0) // Display order

  // Metadata
  createdById String? // Admin who created this FAQ
  createdBy   Account? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Analytics
  viewCount    Int @default(0) // How many times viewed
  helpfulCount Int @default(0) // How many found it helpful

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([isActive])
  @@index([orderIndex])
  @@map("faqs")
}

enum InquiryStatus {
  PENDING // New inquiry, not yet assigned
  IN_PROGRESS // Being worked on by admin
  WAITING_USER // Waiting for user response
  RESOLVED // Issue resolved
  CANCELLED // Cancelled by user

  @@map("inquiry_status")
}

enum SenderType {
  USER // Regular user or guest
  ADMIN // Admin/moderator
  BOT // Chatbot response

  @@map("sender_type")
}

//? ======================================= ITEM SCHEMA ======================================= ?//

model InventoryItem {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  picture     Bytes?
  category    item_category @default(Other)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  item_stacks ItemStack[]

  @@map("inventory_items")
}

//? ====================================== STACKS SCHEMA ====================================== ?//
model ItemStack {
  id         String      @id @default(cuid())
  itemId     String
  quantity   Int         @default(1)
  status     item_status @default(Available)
  date_limit Int? // Number of days the item can be borrowed/distributed (hold by user)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  item             InventoryItem     @relation(fields: [itemId], references: [id])
  itemTransactions ItemTransaction[]

  @@map("item_stacks")
}

//? ==================================== ITEM TRANSACTIONS ==================================== ?//

model ItemTransaction {
  id          String             @id @default(cuid())
  itemStackId String
  accountId   String
  adminId     String? // Admin who approved/rejected/responded to the transaction
  quantity    Int                @default(1)
  status      transaction_status @default(Pending)
  pickupDate  DateTime
  returnDate  DateTime?
  requestNote String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  itemStack ItemStack @relation(fields: [itemStackId], references: [id])
  account   Account   @relation(fields: [accountId], references: [id])
  admin     Account?  @relation("AdminTransactions", fields: [adminId], references: [id])

  @@map("item_transactions")
}

enum transaction_status {
  Pending
  Approved
  Rejected
  Returned
  No_Return
  late_return
  No_Pickup
  Cancelled
}

//? ========================================== ENUMS ========================================== ?//

enum item_status {
  Available
  Unavailable
  Damaged
  EIC
  Distributed
}

enum item_category {
  Farming_Equipment
  Harvesting_Tools
  Irrigation_Systems
  Storage_Equipment
  Processing_Equipment
  Safety_Gear
  Pest_Control
  Livestock_Equipment
  Measuring_Tools
  Fisheries
  Machinery
  Other
}

// User preferences model for storing user settings like language, notifications, etc.

model UserPreference {
  id        Int      @id @default(autoincrement())
  userId    String // Changed to String to match Account.id
  key       String // e.g., 'language', 'notification_email_seminar_updates'
  value     String // e.g., 'en', 'true', 'false'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user Account @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique constraint on userId and key
  @@unique([userId, key])
  @@map("user_preferences")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//? ===================================== SEMINARS SCHEMA ===================================== ?//

model Seminar {
  id                    String         @id @default(cuid())
  title                 String
  description           String         @db.Text
  location              String
  speaker               String
  start_date            DateTime       @db.Date
  end_date              DateTime       @db.Date
  start_time            String
  end_time              String
  capacity              Int
  registration_deadline DateTime       @db.Date
  status                seminar_status @default(Upcoming)
  picture               Bytes?
  mimeType              String?
  createdById           String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  participants SeminarParticipant[]
  creator      Account              @relation("SeminarsCreated", fields: [createdById], references: [id])

  @@map("seminars")
}

model SeminarParticipant {
  id         String             @id @default(cuid())
  seminar_id String
  account_id String
  status     participant_status @default(Registered)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  // Relations
  seminar Seminar @relation(fields: [seminar_id], references: [id])
  account Account @relation(fields: [account_id], references: [id])

  @@unique([seminar_id, account_id])
  @@map("seminar_participants")
}

//? ========================================== ENUMS ========================================== ?//

enum seminar_status {
  Upcoming
  Ongoing
  Completed
  Cancelled
}

enum participant_status {
  Attended
  Not_Attended @map("Not Attended")
  Registered
  Cancelled
}

//? ===================================== SURVEY FORMS SCHEMA ===================================== ?//

model SurveyForm {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  status      survey_status @default(DRAFT)
  category    String
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  creator    Account           @relation("SurveyFormsCreated", fields: [createdById], references: [id])
  fields     SurveyField[]
  responses  SurveyResponse[]
  statistics SurveyStatistic[] @relation("SurveyStatistics")

  @@map("survey_forms")
}

model SurveyField {
  id           String     @id @default(cuid())
  surveyFormId String
  type         field_type
  label        String
  placeholder  String?
  required     Boolean    @default(false)
  options      Json? // For select, radio, checkbox fields
  order        Int // Field order in the form
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  surveyForm SurveyForm     @relation(fields: [surveyFormId], references: [id], onDelete: Cascade)
  answers    SurveyAnswer[]

  @@map("survey_fields")
}

model SurveyResponse {
  id           String   @id @default(cuid())
  surveyFormId String
  userId       String? // Optional - can allow anonymous responses
  submittedAt  DateTime @default(now())
  metadata     Json? // Additional metadata like IP, browser, etc.

  // Relations
  surveyForm SurveyForm     @relation(fields: [surveyFormId], references: [id], onDelete: Cascade)
  user       Account?       @relation("SurveyResponses", fields: [userId], references: [id])
  answers    SurveyAnswer[]

  @@map("survey_responses")
}

model SurveyAnswer {
  id         String   @id @default(cuid())
  responseId String
  fieldId    String
  answer     Json // Store answer as JSON to handle different types
  createdAt  DateTime @default(now())

  // Relations
  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field    SurveyField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([responseId, fieldId]) // One answer per field per response
  @@map("survey_answers")
}

model SurveyStatistic {
  id           String     @id @default(cuid())
  surveyFormId String
  chartType    chart_type // Type of chart (bar, pie, line, etc.)
  title        String // Chart title
  description  String?    @db.Text
  config       Json // Chart configuration and data
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  surveyForm SurveyForm @relation("SurveyStatistics", fields: [surveyFormId], references: [id], onDelete: Cascade)
  creator    Account    @relation("SurveyStatisticsCreated", fields: [createdById], references: [id])

  @@map("survey_statistics")
}

//? ========================================== ENUMS ========================================== ?//

enum survey_status {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum field_type {
  TEXT
  TEXTAREA
  EMAIL
  NUMBER
  DATE
  SELECT
  RADIO
  CHECKBOX
  FILE
}

enum chart_type {
  BAR
  PIE
  LINE
  DOUGHNUT
  AREA
  COLUMN
  SCATTER
}
