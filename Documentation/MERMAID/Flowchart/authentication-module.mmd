flowchart TD
    %% Simple Authentication Flow
    A([Start: User Login]) --> B[/Input Username, Password/]
    B --> C[Validate Credentials]
    C --> DB1[(User Database)]
    C --> D{Valid?}
    
    D -->|Yes| E[/Redirect to Dashboard/]
    D -->|No| F[/Show Error Message/]
    
    F --> B
    E --> G([End: Login Success])
    
    %% Registration Flow
    A --> H[/Click Register/]
    H --> I[/Input User Details/]
    I --> J[Create Account]
    J --> DB2[(User Database)]
    J --> K[/Show Registration Success/]
    K --> B
    
    %% Style Definitions
    classDef startEnd fill:#e1f5fe,stroke:#01579b,stroke-width:3px,color:#000
    classDef process fill:#f3e5f5,stroke:#4a148c,stroke-width:2px,color:#000
    classDef decision fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
    classDef database fill:#e8f5e8,stroke:#1b5e20,stroke-width:2px,color:#000
    classDef inputOutput fill:#fce4ec,stroke:#880e4f,stroke-width:2px,color:#000
    
    class A,G startEnd
    class C,J process
    class D decision
    class DB1,DB2 database
    class B,E,F,H,I,K inputOutput
    
    %% Success Flows
    K --> X[("🍪 Set Authentication Cookie")]
    W --> X
    X --> Y{"👑 User Role Check"}
    
    %% Role-based Redirect
    Y -->|User| Z[("🏠 Redirect to User Dashboard")]
    Y -->|Admin/Super Admin| AA[("⚙️ Redirect to Admin Dashboard")]
    
    %% Error Flows
    J --> F
    U --> M
    
    %% Logout Process
    C --> BB["🚪 User Clicks Logout"]
    Z --> BB
    AA --> BB
    BB --> CC[("🗑️ Clear JWT Cookie")]
    CC --> DD[("🔄 Redirect to Login")]
    DD --> D
    
    %% Session Management
    X --> EE[("⏰ Session Monitoring")]
    EE --> FF{"🕐 Session Expired?"}
    FF -->|Yes| GG[("🔄 Auto-Logout")]
    FF -->|No| EE
    GG --> DD

    %% Style Definitions
    classDef startEnd fill:#e1f5fe,stroke:#01579b,stroke-width:3px,color:#000
    classDef process fill:#f3e5f5,stroke:#4a148c,stroke-width:2px,color:#000
    classDef decision fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
    classDef database fill:#e8f5e8,stroke:#1b5e20,stroke-width:2px,color:#000
    classDef input fill:#fce4ec,stroke:#880e4f,stroke-width:2px,color:#000
    classDef error fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#000
    
    class A,C,Z,AA startEnd
    class F,H,K,M,O,Q,S,V,W,X,BB,CC,DD,EE,GG process
    class B,I,T,Y,FF decision
    class J,U error
