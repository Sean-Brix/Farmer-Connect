flowchart TD
    %% Simple Admin Login
    A([Start: Admin Login]) --> B[/Input Admin Credentials/]
    B --> C[Validate Credentials]
    C --> DB1[(User Database)]
    C --> D{Valid Admin?}
    
    D -->|Yes| E[/Display Admin Dashboard/]
    D -->|No| F[/Access Denied/]
    
    E --> G[/Select: Users, Inventory, Seminars, Analytics/]
    G --> H{{Go to Selected Module}}
    
    F --> I([End: Access Denied])
    H --> J([End: Module Access])
    
    %% Style Definitions
    classDef startEnd fill:#e1f5fe,stroke:#01579b,stroke-width:3px,color:#000
    classDef process fill:#f3e5f5,stroke:#4a148c,stroke-width:2px,color:#000
    classDef decision fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
    classDef database fill:#e8f5e8,stroke:#1b5e20,stroke-width:2px,color:#000
    classDef inputOutput fill:#fce4ec,stroke:#880e4f,stroke-width:2px,color:#000
    classDef connector fill:#f0f4c3,stroke:#827717,stroke-width:2px,color:#000
    
    class A,I,J startEnd
    class C process
    class D decision
    class DB1 database
    class B,E,F,G inputOutput
    class H connector
