flowchart TD
    A[User Visits Landing Page] --> B{Already Logged In?}
    B -->|Yes| C[Show Authenticated Navbar]
    B -->|No| D[Show Guest Navbar]
    
    C --> E[Display User Profile Options]
    E --> F[Access to Client Services]
    F --> G[Seminar Enrollment]
    F --> H[EIC Requests]
    F --> I[Distribution Requests]
    F --> J[Profile Settings]
    
    D --> K[Login/Register Options]
    K --> L{Choose Action}
    L -->|Login| M[Login Form]
    L -->|Register| N[Registration Form]
    
    M --> O[Validate Credentials]
    O -->|Valid| P[Set JWT Cookie]
    O -->|Invalid| Q[Show Error Message]
    Q --> M
    
    N --> R[Validate Registration Data]
    R -->|Valid| S[Create Account]
    R -->|Invalid| T[Show Validation Errors]
    T --> N
    
    S --> U[Auto Login]
    P --> V[Redirect to Dashboard]
    U --> V
