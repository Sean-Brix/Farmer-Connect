flowchart TD
    %% Simple Analytics
    A([Start: Analytics]) --> B[Load Statistics]
    B --> DB1[(Analytics Database)]
    B --> C[/Display: User Activity, Equipment Usage, System Performance/]
    C --> D{Generate Report?}
    
    D -->|Yes| E[Generate Report]
    D -->|No| F([End: View Only])
    
    E --> DB2[(Analytics Database)]
    E --> G[/Display Report, Download Option/]
    G --> H([End: Report Generated])
    
    %% Style Definitions
    classDef startEnd fill:#e1f5fe,stroke:#01579b,stroke-width:3px,color:#000
    classDef process fill:#f3e5f5,stroke:#4a148c,stroke-width:2px,color:#000
    classDef decision fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
    classDef database fill:#e8f5e8,stroke:#1b5e20,stroke-width:2px,color:#000
    classDef inputOutput fill:#fce4ec,stroke:#880e4f,stroke-width:2px,color:#000
    
    class A,F,H startEnd
    class B,E process
    class D decision
    class DB1,DB2 database
    class C,G inputOutput
