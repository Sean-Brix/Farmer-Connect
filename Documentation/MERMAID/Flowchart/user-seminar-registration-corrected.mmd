flowchart TD
    %% User Seminar Registration Flow
    A([Start: User Access Seminars]) --> B{User Authenticated?}
    B -->|No| C[/Redirect to Login/]
    B -->|Yes| D[Load Available Seminars]
    
    D --> DB1[(Seminar Database)]
    D --> E[/Display Seminar List/]
    E --> F[/User Select Seminar/]
    F --> G{Registration Open?}
    
    G -->|No| H[/Show Registration Closed/]
    G -->|Yes| I{Already Registered?}
    I -->|Yes| J[/Show Already Registered/]
    I -->|No| K[/Input Registration Form/]
    K --> L[Submit Registration]
    L --> DB2[(Participant Database)]
    L --> M[/Display Registration Success/]
    
    %% End Points
    M --> N([End: Registration Complete])
    H --> O([End: Registration Failed])
    J --> P([End: Already Registered])
    C --> Q([End: Login Required])
    
    %% Style Definitions
    classDef startEnd fill:#e1f5fe,stroke:#01579b,stroke-width:3px,color:#000
    classDef process fill:#f3e5f5,stroke:#4a148c,stroke-width:2px,color:#000
    classDef decision fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
    classDef database fill:#e8f5e8,stroke:#1b5e20,stroke-width:2px,color:#000
    classDef inputOutput fill:#fce4ec,stroke:#880e4f,stroke-width:2px,color:#000
    
    class A,N,O,P,Q startEnd
    class D,L process
    class B,G,I decision
    class DB1,DB2 database
    class C,E,F,H,J,K,M inputOutput
